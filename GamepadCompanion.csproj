<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\mod</OutputPath>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Ubicacion de Vintage Story. Normalmente sale de la variable de entorno VINTAGE_STORY;
       si no esta definida (o quedo apuntando a una instalacion que ya no existe) se prueban
       las rutas por defecto de cada plataforma. Definir la propiedad aca tambien la deja
       disponible para las macros de Properties/launchSettings.json. -->
  <PropertyGroup>
    <VINTAGE_STORY Condition="!Exists('$(VINTAGE_STORY)/VintagestoryAPI.dll')">$(AppData)/Vintagestory</VINTAGE_STORY>
    <VINTAGE_STORY Condition="!Exists('$(VINTAGE_STORY)/VintagestoryAPI.dll')">$(HOME)/.local/share/vintagestory</VINTAGE_STORY>
  </PropertyGroup>

  <!-- Carpetas del arbol que NO son codigo del mod. El globbing por default de los
       proyectos SDK-style compila todos los **/*.cs, asi que un .cs decompilado o una
       herramienta suelta al lado del mod entra al DLL y rompe el build (paso literal:
       notes-issue8/decomp-parcial/ModLoader.cs). Se excluyen por nombre y no con un
       comodin para que agregar una carpeta nueva sea una decision explicita.
         tools/        herramientas offline (gpclab), con su propio csproj
         notes-issue8/ material de trabajo del issue #8, gitignoreado -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <Compile Remove="notes-issue8/**" />
    <None Remove="tools/**" />
    <None Remove="notes-issue8/**" />
  </ItemGroup>

  <!-- tools/gpclab corre las pruebas de regresion offline y necesita ver los tipos
       internos (el resolver de glifos, sobre todo). Es la unica razon; no se abre
       nada para consumo externo. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>gpclab</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="VerifyVintageStoryPath" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(VINTAGE_STORY)/VintagestoryAPI.dll')"
           Text="Could not find a Vintage Story installation. Set the VINTAGE_STORY environment variable to the game directory (the one containing VintagestoryAPI.dll). Tried: '$(VINTAGE_STORY)'." />
  </Target>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VINTAGE_STORY)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Core">
      <HintPath>$(VINTAGE_STORY)/Lib/OpenTK.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>$(VINTAGE_STORY)/Lib/OpenTK.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Common">
      <HintPath>$(VINTAGE_STORY)/Lib/OpenTK.Windowing.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.GraphicsLibraryFramework">
      <HintPath>$(VINTAGE_STORY)/Lib/OpenTK.Windowing.GraphicsLibraryFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony lo trae el juego. Private=false: NO se copia al output ni entra al
         deps.json, asi que el zip del release no cambia y no hay riesgo de cargar
         un segundo 0Harmony. El AssemblyResolver del juego resuelve por nombre
         simple ignorando la version, asi que compilar contra la que haya hoy
         sigue funcionando si VS actualiza Harmony. -->
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="cairo-sharp">
      <HintPath>$(VINTAGE_STORY)/Lib/cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

<ItemGroup>
  <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

<ItemGroup>
  <Content Include="modicon.png" Condition="Exists('modicon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

<ItemGroup>
  <Content Include="assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

</Project>
